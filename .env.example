# =========================
# NyayaSetu Environment Configuration
# =========================
# Copy this file to .env and update values for your environment

# =========================
# Backend Configuration
# =========================
# See backend/.env.example for backend-specific variables

# =========================
# Development Mode
# =========================
ENVIRONMENT=development
DEBUG=true

# =========================
# Logging
# =========================
LOG_LEVEL=INFO
LOG_TO_FILE=false

# =========================
# Future: Desktop App Configuration
# =========================
# DESKTOP_API_URL=http://localhost:8000

# =========================
# Future: Mobile App Configuration
# =========================
# MOBILE_API_URL=http://localhost:8000
