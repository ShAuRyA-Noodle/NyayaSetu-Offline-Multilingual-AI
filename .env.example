# =========================
# NyayaSetu Backend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# =========================

# --- Environment ---
# "development" (default) enables Ollama fallback, verbose logs
# "production" enforces Groq-only, strict CORS, optimized settings
ENV=development

# --- Database ---
# Local dev (leave unset or blank): uses SQLite at data/governance.db
# Production (Neon): postgresql://user:pass@ep-xxx.neon.tech/dbname?sslmode=require
DATABASE_URL=

# --- LLM (Groq Cloud - required in production) ---
# Get key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Voice (Sarvam AI - required for NyayaVaani) ---
# Get key at https://dashboard.sarvam.ai
SARVAM_API_KEY=

# --- Authentication ---
# REQUIRED in production. Generate via:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# --- First-admin bootstrap (used once by scripts/create_first_admin.py) ---
# Set these locally, run the script, then UNSET them. Never commit values.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Reverse proxy trust (HF Spaces / Vercel / Cloudflare) ---
# Comma-separated list of trusted proxy CIDRs. "*" trusts X-Forwarded-For
# from any proxy (acceptable when running behind a single known LB only).
TRUSTED_PROXIES=*

# --- Captcha (Cloudflare Turnstile) — required in production ---
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# --- CORS ---
# Comma-separated list of allowed origins.
# Dev:  http://localhost:5173,http://localhost:3000
# Prod: https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Server ---
# Render provides PORT automatically; locally defaults to 8001
PORT=8001
HOST=0.0.0.0

# --- RAG ---
# Path to FAISS index (bundled in Docker image)
FAISS_INDEX_PATH=data/faiss_index.bin
# Path to sentence-transformer model cache (bundled in Docker image)
MODEL_CACHE_DIR=models
EMBEDDING_MODEL=paraphrase-multilingual-mpnet-base-v2

# --- Ollama (DEV ONLY - ignored in production) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# --- Observability ---
SENTRY_DSN=
LOG_LEVEL=INFO
