# =========================
# NyayaSetu Backend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# =========================

# --- Environment ---
# "development" (default) enables Ollama fallback, verbose logs
# "production" enforces Groq-only, strict CORS, optimized settings
ENV=development

# --- Database ---
# Local dev (leave unset or blank): uses SQLite at data/governance.db
# Production (Neon): postgresql://user:pass@ep-xxx.neon.tech/dbname?sslmode=require
DATABASE_URL=

# --- LLM (Groq Cloud - required in production) ---
# Get key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Voice (Sarvam AI - required for NyayaVaani) ---
# Get key at https://dashboard.sarvam.ai
SARVAM_API_KEY=

# --- Authentication ---
# Generate a strong random string (32+ chars):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-this-in-production-use-a-strong-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# --- CORS ---
# Comma-separated list of allowed origins.
# Dev:  http://localhost:5173,http://localhost:3000
# Prod: https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Server ---
# Render provides PORT automatically; locally defaults to 8001
PORT=8001
HOST=0.0.0.0

# --- RAG ---
# Path to FAISS index (bundled in Docker image)
FAISS_INDEX_PATH=data/faiss_index.bin
# Path to sentence-transformer model cache (bundled in Docker image)
MODEL_CACHE_DIR=models
EMBEDDING_MODEL=paraphrase-multilingual-mpnet-base-v2

# --- Ollama (DEV ONLY - ignored in production) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# --- Logging ---
LOG_LEVEL=INFO

# --- Optional: Error monitoring ---
SENTRY_DSN=
