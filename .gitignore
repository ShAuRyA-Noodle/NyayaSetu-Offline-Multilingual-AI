translation_models/

# Database files (keep seed files, ignore runtime DBs)
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/cache/
data/audio/
*.sqlite
*.sqlite3

# Database dumps (migration artifacts - never commit)
*.sql.gz
*.dump
*.backup
data/sqlite_export.sql
data/postgres_import.sql

# FAISS indexes and pickles (regenerated from seed data)
data/*.index
data/*.pkl
data/*.bin
# RAG metadata (generated by retriever; pickle->json migration output)
data/schemes_metadata.json

