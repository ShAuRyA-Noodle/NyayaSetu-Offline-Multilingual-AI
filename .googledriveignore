node_modules/
**/node_modules/
.pnp
.pnp.js
desktop/node_modules/
desktop/.vite/
desktop/dist/
desktop/dist-electron/
desktop/release/
desktop/out/

# ─── Python venvs / caches / build ────────────────────────────────────────
.venv/
venv/
env/
ENV/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
wheels/
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
.cache/

