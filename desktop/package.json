{
  "name": "nyayasetu-desktop",
  "version": "1.0.0",
  "description": "NyayaSetu Desktop - Government Services Platform",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build": "tsc && vite build",
    "build:web": "vite build --base=/",
    "build:electron": "vite build --base=./",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@studio-freight/react-lenis": "^0.0.47",
    "axios": "^1.6.2",
    "date-fns": "^2.30.0",
    "framer-motion": "^12.36.0",
    "gsap": "^3.14.2",
    "i18next": "^25.8.18",
    "lenis": "^1.3.19",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^16.5.8",
    "react-router-dom": "^6.20.0",
    "recharts": "^2.10.3",
    "three": "^0.160.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^28.3.3",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.3",
    "vite": "^5.0.7",
    "wait-on": "^7.2.0"
  }
}
