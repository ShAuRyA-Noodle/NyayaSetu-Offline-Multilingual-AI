{
  "name": "nyayasetu-desktop",
  "version": "1.0.0",
  "description": "NyayaSetu Desktop - Government Services Platform",
  "main": "main.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build": "tsc && vite build",
    "build:web": "vite build --base=/",
    "build:electron": "vite build --base=./",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@studio-freight/react-lenis": "^0.0.47",
    "axios": "^1.21.0",
    "date-fns": "^2.30.0",
    "framer-motion": "^12.43.0",
    "gsap": "^3.14.2",
    "i18next": "^25.8.18",
    "lenis": "^1.3.27",
    "lucide-react": "^0.577.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.1",
    "react-i18next": "^16.5.8",
    "react-router-dom": "^7.18.5",
    "recharts": "^2.10.3",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.6.2",
    "concurrently": "^8.2.2",
    "electron": "^44.10.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.3",
    "vite": "^8.3.5",
    "wait-on": "^7.2.0"
  },
  "overrides": {
    "@remix-run/router": "^1.23.2",
    "follow-redirects": "^1.16.2",
    "lodash": "^4.18.0",
    "picomatch": "^4.0.4",
    "esbuild": "^0.25.0",
    "rollup": "^4.59.0",
    "postcss": "$postcss",
    "shell-quote": "^1.12.0",
    "joi": "^17.13.9",
    "undici": "^7.30.1",
    "source-map-js": "^1.2.2",
    "postcss-selector-parser": "^6.1.5"
  }
